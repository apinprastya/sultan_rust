// The register window (plan Phase 8, spec 2.1 §4–§6). Mostly declarative: Rust
// (`crates/ui/src/app.rs`) sets the view properties and receives keys, actions and picks.
//
// Keyboard: one FocusScope holds the focus for the whole window and hands every key to Rust
// (`key`), which decides per screen and per dialog what it means. There are no text fields (the
// session home's barcode field is drawn here and edited in Rust), so no widget swallows keys (the reason `sultan-spike` needed `capture-key-pressed`), and the override
// dialog cannot leak keys to the page below: Rust routes them to the dialog while it is open.
// Clicks on tiles, keypads and key chips call the same paths.

import { Theme, Strings } from "theme.slint";
import { Note, Chip, Card, KeyChip, NoteLine, Avatar, PinDots, Keypad } from "widgets.slint";

export { Note, Chip, Theme, Strings }
// The first-run setup wizard, a window of its own.
export { SetupWindow, SetupForm, SetupStrings } from "setup.slint";
// The Start screen of a single app or a terminal, a window of its own.
export { StartWindow, StartStrings } from "start.slint";
// The back office (phase C4), a window of its own.
export { BackOfficeWindow, BoStrings, BoLogin, BoList, BoProductRow, BoTreeRow, BoCategoryEditor, BoBrandEditor, BoForm, BoGeneral, BoOption, BoValue, BoCombo, BoUnit, BoBarcode, BoComponent, BoHit, BoBranch, BoCustomerRow, BoCustomerList, BoCustomerForm, BoBalanceRow, BoNamedRow, BoNamedEditor, BoReview, BoMerge, BoBalanceSettings } from "backoffice.slint";

export struct UserTile {
    name: string,
    initials: string,
}

export struct LockView {
    cursor: int,
    pad-open: bool,
    pad-name: string,
    pad-initials: string,
    pin-length: int,
    note: Note,
}

export struct OpenView {
    amount: string,
    blocked: bool,
    blocked-name: string,
    blocked-since: string,
    blocked-number: string,
    note: Note,
}

export struct HomeView {
    number: string,
    since: string,
    opening: string,
    note: Note,
    // The attached customer's receipt line (spec 2.5 §10), member code and balance; "" = none.
    customer: string,
    customer-code: string,
    customer-balance: string,
}

// A name-search result in the customer dialog.
export struct CustomerRow {
    name: string,
    detail: string,
}

// The customer dialog (spec 2.5 M5; `crates/ui/src/customer.rs`).
// page: find, shown, sign-up, payout.
export struct CustomerView {
    open: bool,
    page: string,
    by-name: bool,
    can-search: bool,
    query: string,
    cursor: int,
    name: string,
    company: string,
    code: string,
    phone: string,
    group: string,
    tier: string,
    tier-until: string,
    tier-expired: bool,
    balance: string,
    line: string,
    attached: bool,
    field: int,
    new-name: string,
    new-phone: string,
    amount: string,
    confirm: bool,
    note: Note,
}

// The barcode field and the item it found (phase C5; `crates/ui/src/scan.rs`).
// state: 0 nothing shown, 1 an item, 2 no item (`note` says why).
export struct ScanView {
    code: string,
    looking: string,
    state: int,
    scanned: string,
    note: Note,
    name: string,
    variant: string,
    sku: string,
    unit: string,
    qty: string,
    plu: string,
    kind: string,
    match: string,
    matched: string,
    amount: string,
    open-price: bool,
    requires-note: bool,
    // Prices (spec 2.3 R5; `crates/ui/src/app.rs` `scan_view`): `label`, `open`, `none`,
    // `weight` or `unit`; the store price of one unit; a weight label's amount.
    price-kind: string,
    price: string,
    total: string,
    // The attached customer's price: 0 none, 1 waiting, 2 its own price, 3 the store price,
    // 4 failed (`cust-note`).
    cust-state: int,
    cust-price: string,
    cust-total: string,
    cust-source: string,
    cust-name: string,
    cust-diff: string,
    cust-note: Note,
}

export struct DenomRow {
    label: string,
    qty: string,
    subtotal: string,
    coin: bool,
}

export struct CloseView {
    cursor: int,
    total: string,
    total-locked: bool,
    confirm: bool,
    note: Note,
}

export struct ReportLine {
    label: string,
    value: string,
    tone: int,
    strong: bool,
}

export struct ReportView {
    number: string,
    over-short: string,
    tone: int,
    forced: bool,
    has-tenders: bool,
}

export struct OverrideView {
    open: bool,
    action: string,
    value: string,
    limit: string,
    cursor: int,
    pin-length: int,
    note: Note,
}

component Title inherits Text {
    color: Theme.text;
    font-size: 26px;
    font-weight: 700;
}

component Subtitle inherits Text {
    color: Theme.muted;
    font-size: 15px;
    wrap: word-wrap;
}

component Header inherits Rectangle {
    in property <string> branch;
    in property <string> register;
    in property <string> user;
    in property <string> clock;
    in property <bool> busy;
    height: 60px;
    background: Theme.panel;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: Theme.accent;
                Text {
                    text: "S";
                    color: white;
                    font-size: 18px;
                    font-weight: 800;
                }
            }
        }
        Text {
            text: "Sultan";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.branch;
            color: Theme.muted;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: root.busy ? @tr("Working…") : "";
            color: Theme.warn;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            text: root.register;
            color: Theme.muted;
            vertical-alignment: center;
        }
        if root.user != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 30px;
                border-radius: 15px;
                background: Theme.raised;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.user;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: root.clock;
            color: Theme.text;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component Tile inherits Rectangle {
    in property <UserTile> user;
    in property <bool> selected;
    callback clicked;
    accessible-role: button;
    accessible-label: root.user.name;
    accessible-action-default => { root.clicked(); }
    border-radius: 16px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: root.selected ? Theme.raised : touch.has-hover ? Theme.raised : Theme.panel;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 12px;
        HorizontalLayout {
            alignment: center;
            Avatar {
                initials: root.user.initials;
            }
        }
        Text {
            text: root.user.name;
            color: Theme.text;
            font-size: 17px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

component LockPage inherits Rectangle {
    in property <[UserTile]> users;
    in property <int> columns;
    in property <LockView> view;
    callback pick(int);
    callback key(string);
    property <length> gap: 16px;
    VerticalLayout {
        padding: 32px;
        spacing: 18px;
        Title {
            text: @tr("Who is at the register?");
        }
        Subtitle {
            text: @tr("Pick your name with the arrow keys or a tap, then type your PIN.");
        }
        grid := Flickable {
            vertical-stretch: 1;
            property <length> tile-w: min(220px, (self.width - (root.columns - 1) * root.gap) / root.columns);
            property <length> tile-h: 150px;
            content-height: Math.ceil(root.users.length / root.columns) * (self.tile-h + root.gap);
            for u[i] in root.users: Tile {
                x: Math.mod(i, root.columns) * (grid.tile-w + root.gap);
                y: Math.floor(i / root.columns) * (grid.tile-h + root.gap);
                width: grid.tile-w;
                height: grid.tile-h;
                user: u;
                selected: i == root.view.cursor;
                clicked => {
                    root.pick(i);
                }
            }
        }
        if root.users.length == 0: Subtitle {
            text: @tr("No users with a PIN at this branch yet. Add them in back office, then press F5.");
        }
        if !root.view.pad-open: NoteLine {
            note: root.view.note;
        }
    }

    // The PIN pad, over the tiles.
    if root.view.pad-open: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Card {
            width: 400px;
            height: 600px;
            background: Theme.raised;
            VerticalLayout {
                padding: 28px;
                spacing: 16px;
                HorizontalLayout {
                    alignment: center;
                    Avatar {
                        initials: root.view.pad-initials;
                        size: 56px;
                    }
                }
                Text {
                    text: root.view.pad-name;
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                PinDots {
                    length: root.view.pin-length;
                }
                Rectangle {
                    min-height: 44px;
                    NoteLine {
                        width: 100%;
                        note: root.view.note;
                    }
                }
                Keypad {
                    key(k) => {
                        root.key(k);
                    }
                }
            }
        }
    }
}

component OpenPage inherits Rectangle {
    in property <OpenView> view;
    callback key(string);
    callback action(string);
    Card {
        width: 560px;
        height: root.view.blocked ? 300px : 640px;
        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            if !root.view.blocked: Title {
                text: @tr("Open your cashier session");
            }
            if !root.view.blocked: Subtitle {
                text: @tr("Count the cash in the drawer and type the opening amount. Enter opens the session.");
            }
            if !root.view.blocked: Rectangle {
                height: 84px;
                border-radius: 12px;
                background: Theme.bg;
                border-width: 2px;
                border-color: Theme.accent;
                Text {
                    text: root.view.amount;
                    color: Theme.text;
                    font-size: 42px;
                    font-weight: 700;
                }
            }
            if !root.view.blocked: NoteLine {
                note: root.view.note;
            }
            if !root.view.blocked: Keypad {
                key(k) => {
                    root.key(k);
                }
            }
            if root.view.blocked: Title {
                text: @tr("This register is in use");
            }
            if root.view.blocked: Subtitle {
                text: @tr("{} has had a cashier session open here since {}. Only they can close it: they count and close first, then you open your own session.", root.view.blocked-name, root.view.blocked-since);
            }
            if root.view.blocked && root.view.blocked-number != "": Subtitle {
                text: @tr("Session {}", root.view.blocked-number);
            }
            if root.view.blocked: NoteLine {
                note: root.view.note;
            }
        }
    }
}

component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    border-radius: 12px;
    background: Theme.raised;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.muted;
            font-size: 12px;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
        }
    }
}

// The barcode field: drawn here, edited in Rust (every key goes through the window's
// FocusScope, so the field never takes the focus away from the shortcuts).
component ScanBox inherits Rectangle {
    in property <ScanView> view;
    callback action(string);
    accessible-role: text-input;
    accessible-label: @tr("Barcode, SKU or PLU");
    accessible-value: root.view.code;
    height: 68px;
    border-radius: 12px;
    border-width: 2px;
    border-color: Theme.accent;
    background: Theme.raised;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: @tr("BARCODE · SKU · PLU");
                color: Theme.muted;
                font-size: 11px;
                font-weight: 700;
            }
            HorizontalLayout {
                spacing: 2px;
                alignment: start;
                if root.view.code != "": Text {
                    text: root.view.code;
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                // The caret: the field always has the keyboard.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 2px;
                        height: 24px;
                        background: Theme.accent;
                    }
                }
                if root.view.code == "": Text {
                    text: @tr("Scan or type a code, then press Enter");
                    color: Theme.muted;
                    font-size: 16px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        if root.view.looking != "": Text {
            text: @tr("Looking up {}…", root.view.looking);
            color: Theme.warn;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            max-width: 200px;
        }
        VerticalLayout {
            alignment: center;
            KeyChip {
                keys: "Enter";
                label: Strings.chip("look_up");
                clicked => {
                    root.action("confirm");
                }
            }
        }
        VerticalLayout {
            alignment: center;
            KeyChip {
                keys: "Esc";
                label: Strings.chip("clear");
                clicked => {
                    root.action("back");
                }
            }
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
    }
    Text {
        text: root.value == "" ? "–" : root.value;
        color: Theme.text;
        font-size: 18px;
        font-weight: 600;
        overflow: elide;
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    height: 26px;
    border-radius: 13px;
    background: Theme.accent-soft;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// The shown item's prices (spec 2.3 R5): the store price (or the amount of a scale label, or why
// there is none) and, with a customer attached, the customer's price and where it comes from.
component PriceBox inherits Rectangle {
    in property <ScanView> view;
    property <bool> label: root.view.price-kind == "label";
    property <bool> weight: root.view.price-kind == "weight";
    border-radius: 10px;
    background: Theme.raised;
    accessible-role: groupbox;
    accessible-label: @tr("Price");
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                min-width: 150px;
                text: root.label ? @tr("Amount on the label") : root.weight ? @tr("Amount for this weight") : root.view.price-kind == "unit" ? @tr("Price per {}", root.view.unit) : @tr("Price");
                color: Theme.muted;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: root.label ? root.view.amount : root.weight ? root.view.total : root.view.price-kind == "unit" ? root.view.price : root.view.price-kind == "open" ? @tr("Typed at sale") : @tr("Not priced yet");
                color: root.view.price-kind == "none" ? Theme.warn : Theme.text;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: root.label ? (root.view.qty != "" ? @tr("Final amount: {} at {} per {}", root.view.qty, root.view.price, root.view.unit) : @tr("Final amount. No store price, so the quantity stays empty.")) : root.weight ? @tr("{} × {} per {}", root.view.qty, root.view.price, root.view.unit) : root.view.price-kind == "open" ? (root.view.price != "" ? @tr("Open price. Suggested: {}", root.view.price) : @tr("Open price: the cashier types it at sale.")) : root.view.price-kind == "none" ? @tr("Set a price in the back office before selling.") : "";
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        if root.view.cust-state != 0: HorizontalLayout {
            spacing: 12px;
            Text {
                min-width: 150px;
                text: @tr("Customer price");
                color: Theme.muted;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: root.view.cust-state == 4 ? 1 : 0;
                text: root.view.cust-state == 1 ? @tr("Checking the customer’s price…") : root.view.cust-state == 3 ? @tr("Same as the store price") : root.view.cust-state == 4 ? Strings.message(root.view.cust-note.code, root.view.cust-note.arg) : root.weight ? root.view.cust-total : root.view.cust-price;
                color: root.view.cust-state == 2 ? Theme.success : root.view.cust-state == 4 ? Theme.danger : Theme.muted;
                font-size: root.view.cust-state == 2 ? 20px : 15px;
                font-weight: root.view.cust-state == 2 ? 700 : 400;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.view.cust-state != 4: Text {
                horizontal-stretch: 1;
                text: root.view.cust-state != 2 ? "" : Strings.price-source(root.view.cust-source, root.view.cust-name) + (root.view.cust-diff != "" ? " · " + root.view.cust-diff : "") + (root.weight ? " · " + @tr("at {} per {}", root.view.cust-price, root.view.unit) : "");
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// What the last scan found, with its prices (`PriceBox`).
component ItemPanel inherits Card {
    in property <ScanView> view;
    if root.view.state == 0: VerticalLayout {
        padding: 24px;
        alignment: center;
        spacing: 8px;
        Text {
            text: root.view.looking != "" ? @tr("Looking up {}…", root.view.looking) : @tr("Scan an item to see it here.");
            color: Theme.text;
            font-size: 18px;
            horizontal-alignment: center;
        }
        Subtitle {
            text: @tr("Selling arrives in a later version.") + " " + @tr("Your session stays open while the register is locked.");
            horizontal-alignment: center;
        }
    }
    if root.view.state == 2: VerticalLayout {
        padding: 24px;
        alignment: center;
        spacing: 10px;
        Text {
            text: Strings.message(root.view.note.code, root.view.note.arg);
            color: Theme.danger;
            font-size: 22px;
            font-weight: 700;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Subtitle {
            text: @tr("Check the item or the label and scan again. Esc clears.");
            horizontal-alignment: center;
        }
    }
    if root.view.state == 1: VerticalLayout {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.view.name;
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.view.variant;
                    color: Theme.muted;
                    font-size: 16px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    Badge {
                        text: Strings.product-type(root.view.kind);
                    }
                    if root.view.open-price: Badge {
                        text: @tr("Open price");
                        tint: Theme.warn;
                    }
                    if root.view.requires-note: Badge {
                        text: @tr("Needs a note");
                        tint: Theme.warn;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 16px;
            Field {
                horizontal-stretch: 1;
                label: @tr("Quantity");
                value: root.view.qty;
            }
            Field {
                horizontal-stretch: 1;
                label: @tr("Unit");
                value: root.view.unit;
            }
            Field {
                horizontal-stretch: 1;
                label: "SKU";
                value: root.view.sku;
            }
            Field {
                horizontal-stretch: 1;
                label: "PLU";
                value: root.view.plu;
            }
        }
        HorizontalLayout {
            spacing: 16px;
            Field {
                horizontal-stretch: 1;
                label: @tr("Found by");
                value: Strings.match-kind(root.view.match);
            }
            Field {
                horizontal-stretch: 3;
                label: @tr("Code");
                value: root.view.matched;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        PriceBox {
            view: root.view;
        }
    }
}

// The attached customer on the session home; a click opens the customer dialog.
component CustomerStrip inherits Rectangle {
    in property <HomeView> view;
    callback clicked;
    accessible-role: button;
    accessible-label: root.view.customer != "" ? @tr("Attached customer") : @tr("No customer attached");
    accessible-value: root.view.customer;
    accessible-action-default => { root.clicked(); }
    height: 56px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.view.customer != "" ? Theme.success : Theme.border;
    background: touch.has-hover ? Theme.raised : Theme.panel;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        Text {
            text: @tr("CUSTOMER");
            color: Theme.muted;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.view.customer != "" ? root.view.customer : @tr("None. F3 finds a customer or signs one up.");
            color: root.view.customer != "" ? Theme.text : Theme.muted;
            font-size: root.view.customer != "" ? 18px : 14px;
            font-weight: root.view.customer != "" ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.view.customer-code != "": Text {
            text: root.view.customer-code;
            color: Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
        }
        if root.view.customer != "": Text {
            text: @tr("Balance {}", root.view.customer-balance);
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component HomePage inherits Rectangle {
    in property <string> user;
    in property <HomeView> view;
    in property <ScanView> scan;
    in property <[Chip]> chips;
    callback action(string);
    HorizontalLayout {
        padding: 28px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    Title {
                        text: @tr("Hello, {}", root.user);
                        overflow: elide;
                    }
                    if root.view.number != "": Subtitle {
                        text: @tr("Session {}", root.view.number);
                    }
                }
                Stat {
                    label: @tr("Session open since");
                    value: root.view.since;
                }
                Stat {
                    label: @tr("Opening cash");
                    value: root.view.opening;
                }
            }
            CustomerStrip {
                view: root.view;
                clicked => {
                    root.action("customer");
                }
            }
            ScanBox {
                view: root.scan;
                action(a) => {
                    root.action(a);
                }
            }
            ItemPanel {
                vertical-stretch: 1;
                view: root.scan;
            }
            NoteLine {
                note: root.view.note;
                horizontal-alignment: left;
            }
        }
        VerticalLayout {
            width: 260px;
            spacing: 12px;
            Text {
                text: @tr("ACTIONS");
                color: Theme.muted;
                font-size: 12px;
                font-weight: 700;
            }
            for c in root.chips: KeyChip {
                keys: c.keys;
                label: Strings.chip(c.label);
                large: true;
                clicked => {
                    root.action(c.id);
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}

// A text field of the customer dialog: drawn here, edited in Rust like the barcode field.
component TypedField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder;
    in property <bool> focused: true;
    callback clicked;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.value;
    height: 64px;
    border-radius: 12px;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.accent : Theme.border;
    background: Theme.bg;
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 700;
        }
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            if root.value != "": Text {
                text: root.value;
                color: Theme.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.focused: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 2px;
                    height: 22px;
                    background: Theme.accent;
                }
            }
            if root.value == "": Text {
                text: root.placeholder;
                color: Theme.muted;
                font-size: 15px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component CustomerLine inherits Rectangle {
    in property <CustomerRow> item;
    in property <bool> selected;
    callback clicked;
    accessible-role: button;
    accessible-label: root.item.name;
    accessible-action-default => { root.clicked(); }
    height: 54px;
    border-radius: 10px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.border : transparent;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.accent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.item.name;
            color: Theme.text;
            font-size: 16px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.item.detail;
            color: Theme.muted;
            font-size: 13px;
            overflow: elide;
        }
    }
}

// The customer dialog (spec 2.5 M5): find, the found customer, sign-up, balance payout. Keys go
// to Rust like everywhere else; the chips are the dialog's keys.
component CustomerDialog inherits Rectangle {
    in property <CustomerView> view;
    in property <[CustomerRow]> rows;
    in property <[Chip]> chips;
    callback key(string);
    callback pick(string, int);
    callback action(string);
    background: Theme.scrim;
    TouchArea { }
    Card {
        width: min(root.width - 48px, 820px);
        height: min(root.height - 48px, 620px);
        background: Theme.raised;
        VerticalLayout {
            padding: 26px;
            spacing: 14px;
            if root.view.page == "find": VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Title {
                    text: @tr("Find a customer");
                    font-size: 22px;
                }
                Subtitle {
                    text: root.view.by-name ? @tr("Type part of the name or the company name, then press Enter.") : @tr("Type the phone number or the member code, or scan the member card, then press Enter.");
                }
                TypedField {
                    label: root.view.by-name ? @tr("Name") : @tr("Phone or member code");
                    value: root.view.query;
                    placeholder: root.view.by-name ? @tr("e.g. Budi") : @tr("e.g. 0812 3456 789 or K7QH-29XM");
                }
                if root.view.by-name: Flickable {
                    vertical-stretch: 1;
                    content-height: root.rows.length * 58px;
                    for r[i] in root.rows: CustomerLine {
                        y: i * 58px;
                        width: parent.width;
                        item: r;
                        selected: i == root.view.cursor;
                        clicked => {
                            root.pick("customer", i);
                        }
                    }
                }
                if !root.view.by-name: Rectangle {
                    vertical-stretch: 1;
                }
            }
            if root.view.page == "shown": VerticalLayout {
                vertical-stretch: 1;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Title {
                            text: root.view.name;
                            overflow: elide;
                        }
                        if root.view.company != "": Subtitle {
                            text: root.view.company;
                        }
                    }
                    if root.view.attached: VerticalLayout {
                        alignment: start;
                        Badge {
                            text: @tr("Attached");
                            tint: Theme.success;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Field {
                        horizontal-stretch: 1;
                        label: @tr("Member code");
                        value: root.view.code;
                    }
                    Field {
                        horizontal-stretch: 1;
                        label: @tr("Phone");
                        value: root.view.phone;
                    }
                    Field {
                        horizontal-stretch: 1;
                        label: @tr("Group");
                        value: root.view.group;
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: @tr("Tier");
                            color: Theme.muted;
                            font-size: 12px;
                        }
                        Text {
                            text: root.view.tier == "" ? "–" : root.view.tier-expired ? @tr("{} (expired {})", root.view.tier, root.view.tier-until) : root.view.tier-until != "" ? @tr("{} · until {}", root.view.tier, root.view.tier-until) : root.view.tier;
                            color: root.view.tier-expired ? Theme.warn : Theme.text;
                            font-size: 18px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }
                    Stat {
                        label: @tr("Balance");
                        value: root.view.balance;
                    }
                }
                Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            text: @tr("On the receipt");
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.view.line;
                            color: Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                Text {
                    text: @tr("RECENT RECEIPTS");
                    color: Theme.muted;
                    font-size: 12px;
                    font-weight: 700;
                }
                Subtitle {
                    text: @tr("No receipts yet. The 5 most recent receipts show here once selling arrives.");
                }
                Rectangle {
                    vertical-stretch: 1;
                }
            }
            if root.view.page == "sign-up": VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Title {
                    text: @tr("New customer");
                    font-size: 22px;
                }
                Subtitle {
                    text: @tr("Type the name and, if the customer wants, the phone number. The member code is given automatically. Tab moves to the next field.");
                }
                TypedField {
                    label: @tr("Name");
                    value: root.view.new-name;
                    placeholder: @tr("Full name");
                    focused: root.view.field == 0;
                    clicked => {
                        root.pick("field", 0);
                    }
                }
                TypedField {
                    label: @tr("Phone (optional)");
                    value: root.view.new-phone;
                    placeholder: @tr("e.g. 0812 3456 789");
                    focused: root.view.field == 1;
                    clicked => {
                        root.pick("field", 1);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
            }
            if root.view.page == "payout": HorizontalLayout {
                vertical-stretch: 1;
                spacing: 24px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    Title {
                        text: @tr("Pay out the balance");
                        font-size: 22px;
                    }
                    Subtitle {
                        text: @tr("{} has a balance of {}. The amount is paid in cash from your drawer.", root.view.name, root.view.balance);
                    }
                    Rectangle {
                        accessible-role: text-input;
                        accessible-label: @tr("Amount to pay out");
                        accessible-value: root.view.amount;
                        height: 84px;
                        border-radius: 12px;
                        background: Theme.bg;
                        border-width: 2px;
                        border-color: root.view.confirm ? Theme.border : Theme.accent;
                        Text {
                            text: root.view.amount;
                            color: Theme.text;
                            font-size: 40px;
                            font-weight: 700;
                        }
                    }
                    if root.view.confirm: Rectangle {
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.warn;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            Text {
                                text: @tr("Pay out {} in cash to {}?", root.view.amount, root.view.name);
                                color: Theme.text;
                                font-size: 17px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            Subtitle {
                                text: @tr("Enter pays out. Esc changes the amount.");
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
                VerticalLayout {
                    width: 280px;
                    alignment: start;
                    Keypad {
                        key(k) => {
                            root.key(k);
                        }
                    }
                }
            }
            NoteLine {
                note: root.view.note;
                horizontal-alignment: left;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                for c in root.chips: KeyChip {
                    keys: c.keys;
                    label: Strings.chip(c.label);
                    clicked => {
                        root.action(c.id);
                    }
                }
            }
        }
    }
}

component DenomLine inherits Rectangle {
    in property <DenomRow> item;
    in property <bool> selected;
    in property <bool> enabled;
    callback clicked;
    accessible-role: button;
    accessible-label: root.item.label;
    accessible-action-default => { root.clicked(); }
    height: 38px;
    border-radius: 8px;
    background: root.selected && root.enabled ? Theme.accent-soft : transparent;
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            text: root.item.label;
            color: Theme.text;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.item.coin ? @tr("coin") : "";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            width: 60px;
        }
        Rectangle {
            width: 90px;
            border-radius: 6px;
            background: Theme.bg;
            border-width: root.selected && root.enabled ? 2px : 1px;
            border-color: root.selected && root.enabled ? Theme.accent : Theme.border;
            Text {
                text: root.item.qty == "" ? "0" : root.item.qty;
                color: root.item.qty == "" ? Theme.muted : Theme.text;
                font-size: 16px;
                horizontal-alignment: right;
                width: parent.width - 16px;
            }
        }
        Text {
            text: root.item.subtotal;
            color: Theme.text;
            width: 140px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component ClosePage inherits Rectangle {
    in property <[DenomRow]> denoms;
    in property <CloseView> view;
    callback key(string);
    callback pick(int);
    HorizontalLayout {
        padding: 24px;
        spacing: 24px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 2px;
                Title {
                    text: @tr("Count the drawer");
                    font-size: 22px;
                }
                Subtitle {
                    text: @tr("Optional: count notes and coins (↑ ↓ to move, digits to type). They add up automatically.");
                }
                Rectangle {
                    height: 8px;
                }
                for d[i] in root.denoms: DenomLine {
                    item: d;
                    selected: root.view.cursor == i + 1;
                    enabled: !root.view.confirm;
                    clicked => {
                        root.pick(i + 1);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }
        VerticalLayout {
            width: 400px;
            spacing: 14px;
            Card {
                height: 150px;
                border-width: root.view.cursor == 0 && !root.view.confirm ? 2px : 1px;
                border-color: root.view.cursor == 0 && !root.view.confirm ? Theme.accent : Theme.border;
                accessible-role: button;
                accessible-label: @tr("Counted cash");
                TouchArea {
                    clicked => {
                        root.pick(0);
                    }
                }
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    Text {
                        text: @tr("Counted cash");
                        color: Theme.muted;
                        font-size: 13px;
                    }
                    Text {
                        text: root.view.total;
                        color: Theme.text;
                        font-size: 38px;
                        font-weight: 800;
                    }
                    Text {
                        text: root.view.total-locked ? @tr("Sum of the notes and coins") : @tr("Type the total, or count per denomination");
                        color: Theme.muted;
                        font-size: 13px;
                    }
                }
            }
            if root.view.confirm: Card {
                background: Theme.raised;
                border-color: Theme.warn;
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    Text {
                        text: @tr("Close the session with {} counted?", root.view.total);
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Subtitle {
                        text: @tr("This cannot be undone. The report shows the expected cash after closing.");
                    }
                }
            }
            if !root.view.confirm: Keypad {
                key(k) => {
                    root.key(k);
                }
            }
            NoteLine {
                note: root.view.note;
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}

component ReportRow inherits HorizontalLayout {
    in property <ReportLine> line;
    spacing: 12px;
    Text {
        text: Strings.label(root.line.label);
        color: root.line.strong ? Theme.text : Theme.muted;
        font-weight: root.line.strong ? 700 : 400;
        horizontal-stretch: 1;
    }
    Text {
        text: root.line.value;
        color: root.line.tone == 0 ? Theme.text : Theme.tone-color(root.line.tone);
        font-weight: root.line.strong ? 700 : 400;
        horizontal-alignment: right;
    }
}

component ReportPage inherits Rectangle {
    in property <[ReportLine]> lines;
    in property <[ReportLine]> tenders;
    in property <ReportView> view;
    callback action(string);
    Card {
        width: 620px;
        height: min(root.height - 32px, 660px);
        VerticalLayout {
            padding: 28px;
            spacing: 10px;
            Title {
                text: @tr("Session closed");
            }
            if root.view.number != "": Subtitle {
                text: @tr("Session {}", root.view.number);
            }
            if root.view.forced: Subtitle {
                text: @tr("Force-closed by a manager.");
            }
            Rectangle {
                height: 72px;
                border-radius: 12px;
                background: root.view.tone > 0 ? Theme.success-soft : root.view.tone < 0 ? Theme.danger-soft : Theme.raised;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    Text {
                        text: root.view.tone > 0 ? @tr("Over") : root.view.tone < 0 ? @tr("Short") : @tr("Balanced");
                        color: Theme.tone-color(root.view.tone);
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.view.over-short;
                        color: root.view.tone == 0 ? Theme.text : Theme.tone-color(root.view.tone);
                        font-size: 30px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
            }
            for l in root.lines: ReportRow {
                line: l;
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Text {
                text: @tr("TENDERS");
                color: Theme.muted;
                font-size: 12px;
                font-weight: 700;
            }
            if !root.view.has-tenders: Subtitle {
                text: @tr("No sales in this session.");
            }
            for t in root.tenders: ReportRow {
                line: t;
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}

component ManagerRow inherits Rectangle {
    in property <UserTile> user;
    in property <bool> selected;
    callback clicked;
    accessible-role: button;
    accessible-label: root.user.name;
    accessible-action-default => { root.clicked(); }
    height: 56px;
    border-radius: 10px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.border : transparent;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.accent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                initials: root.user.initials;
                size: 36px;
            }
        }
        Text {
            text: root.user.name;
            color: Theme.text;
            font-size: 16px;
            vertical-alignment: center;
        }
    }
}

component OverrideDialog inherits Rectangle {
    in property <OverrideView> view;
    in property <[UserTile]> managers;
    callback key(string);
    callback pick(int);
    callback action(string);
    background: Theme.scrim;
    TouchArea { }
    Card {
        width: 760px;
        height: 620px;
        background: Theme.raised;
        VerticalLayout {
            padding: 26px;
            spacing: 14px;
            Title {
                text: @tr("Manager approval needed");
                font-size: 22px;
            }
            Text {
                text: Strings.action(root.view.action) + " " + root.view.value;
                color: Theme.warn;
                font-size: 20px;
                font-weight: 700;
            }
            if root.view.limit != "": Subtitle {
                text: @tr("Your limit is {}. A manager picks their name and types their PIN.", root.view.limit);
            }
            HorizontalLayout {
                spacing: 24px;
                vertical-stretch: 1;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Text {
                        text: @tr("MANAGER (↑ ↓)");
                        color: Theme.muted;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.managers.length * 60px;
                        for m[i] in root.managers: ManagerRow {
                            y: i * 60px;
                            width: parent.width;
                            user: m;
                            selected: i == root.view.cursor;
                            clicked => {
                                root.pick(i);
                            }
                        }
                    }
                }
                VerticalLayout {
                    width: 300px;
                    spacing: 14px;
                    PinDots {
                        length: root.view.pin-length;
                    }
                    Keypad {
                        key(k) => {
                            root.key(k);
                        }
                    }
                }
            }
            NoteLine {
                note: root.view.note;
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                KeyChip {
                    keys: "Esc";
                    label: Strings.chip("cancel");
                    clicked => {
                        root.action("back");
                    }
                }
                KeyChip {
                    keys: "Enter";
                    label: Strings.chip("approve");
                    clicked => {
                        root.action("confirm");
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: @tr("Sultan POS · Register");
    preferred-width: 1366px;
    preferred-height: 768px;
    min-width: 1024px;
    min-height: 700px;
    background: Theme.bg;
    default-font-size: 15px;
    forward-focus: keys;

    in property <string> screen: "lock";
    in property <string> branch-label;
    in property <string> register-label;
    in property <string> user-name;
    in property <string> clock;
    in property <bool> busy;
    in property <[Chip]> chips;
    // The session home's actions (fixed; `chips` change while the dialog is open).
    in property <[Chip]> actions;
    in property <[UserTile]> users;
    in property <int> columns: 4;
    in property <LockView> lock;
    in property <OpenView> open;
    in property <HomeView> home;
    in property <ScanView> scan;
    in property <[DenomRow]> denoms;
    in property <CloseView> closing;
    in property <[ReportLine]> report-lines;
    in property <[ReportLine]> report-tenders;
    in property <ReportView> report;
    in property <[UserTile]> managers;
    in property <OverrideView> approval;
    in property <CustomerView> customer;
    in property <[CustomerRow]> customers;
    out property <bool> has-focus: keys.has-focus;

    // A key (Slint key text and modifiers); true = handled.
    callback key(string, bool, bool) -> bool;
    // A chip or button (`crates/ui/src/controller.rs` `Action` IDs).
    callback action(string);
    // A click on a list item: kind (`user`, `approver`, `row`, `customer`, `field`) and index.
    callback pick(string, int);
    // Results of background calls are waiting (posted from other threads).
    callback pump();

    // The texts as shown, in the current language (used by the headless tests).
    public pure function message(note: Note) -> string {
        return Strings.message(note.code, note.arg);
    }
    public pure function chip-label(code: string) -> string {
        return Strings.chip(code);
    }
    public pure function price-source(kind: string, name: string) -> string {
        return Strings.price-source(kind, name);
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            Header {
                branch: root.branch-label;
                register: root.register-label;
                user: root.user-name;
                clock: root.clock;
                busy: root.busy;
            }

            Rectangle {
                vertical-stretch: 1;
                if root.screen == "lock": LockPage {
                    users: root.users;
                    columns: root.columns;
                    view: root.lock;
                    pick(i) => {
                        root.pick("user", i);
                    }
                    key(k) => {
                        root.key(k, false, false);
                    }
                }
                if root.screen == "open": OpenPage {
                    view: root.open;
                    key(k) => {
                        root.key(k, false, false);
                    }
                    action(a) => {
                        root.action(a);
                    }
                }
                if root.screen == "home": HomePage {
                    user: root.user-name;
                    view: root.home;
                    scan: root.scan;
                    chips: root.actions;
                    action(a) => {
                        root.action(a);
                    }
                }
                if root.screen == "close": ClosePage {
                    denoms: root.denoms;
                    view: root.closing;
                    key(k) => {
                        root.key(k, false, false);
                    }
                    pick(i) => {
                        root.pick("row", i);
                    }
                }
                if root.screen == "report": ReportPage {
                    lines: root.report-lines;
                    tenders: root.report-tenders;
                    view: root.report;
                    action(a) => {
                        root.action(a);
                    }
                }
            }

            // Key hints for the current screen or dialog; each chip is also a button.
            Rectangle {
                height: 60px;
                background: Theme.panel;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }
                // The home page shows its actions as large buttons; the dialog has its own.
                if !root.approval.open && root.screen != "home": HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 10px;
                    alignment: start;
                    for c in root.chips: KeyChip {
                        keys: c.keys;
                        label: Strings.chip(c.label);
                        clicked => {
                            root.action(c.id);
                        }
                    }
                }
            }
        }

        if root.customer.open: CustomerDialog {
            width: 100%;
            height: 100%;
            view: root.customer;
            rows: root.customers;
            chips: root.chips;
            key(k) => {
                root.key(k, false, false);
            }
            pick(kind, i) => {
                root.pick(kind, i);
            }
            action(a) => {
                root.action(a);
            }
        }

        if root.approval.open: OverrideDialog {
            width: 100%;
            height: 100%;
            view: root.approval;
            managers: root.managers;
            key(k) => {
                root.key(k, false, false);
            }
            pick(i) => {
                root.pick("approver", i);
            }
            action(a) => {
                root.action(a);
            }
        }
    }
}
