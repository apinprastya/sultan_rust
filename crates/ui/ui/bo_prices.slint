// The back office's pricing screens (spec 2.3, phase R4): price lists, tax rates and the
// pricing settings (F7, tabs Ctrl+1 … Ctrl+3). The product form's Prices tab is in
// `bo_price_tab.slint`. Rust (`crates/ui/src/backoffice/pricing.rs`) decides everything; these
// components show it and report edits and clicks like the other screens.
//
// Text fields are rebuilt when Rust bumps `serial` (a list is picked, a save answered).

import { ComboBox, CheckBox, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Note, Card } from "widgets.slint";
import { BoStrings, Field, SmallButton, KeyButton, Banner, SectionTitle } from "bo_widgets.slint";
import { TabButton } from "bo_form.slint";

export struct BoPriceListRow {
    name: string,
    kind: string,
    target: string,
    rule: string,
    active: bool,
}

export struct BoPriceListEditor {
    is-new: bool,
    is-default: bool,
    kind: string,
    kind-index: int,
    target-index: int,
    target-name: string,
    customer: string,
    name: string,
    active: bool,
    rule-index: int,
    rule-value: string,
    cursor: int,
    can-edit: bool,
    notice: Note,
    name-error: Note,
    target-error: Note,
    rule-error: Note,
}

export struct BoTaxRateRow {
    valid-from: string,
    rate: string,
    status: string,
}

export struct BoTaxRates {
    cursor: int,
    class-name: string,
    rate: string,
    valid-from: string,
    can-edit: bool,
    notice: Note,
    rate-error: Note,
    from-error: Note,
}

export struct BoPricingSettings {
    tax-inclusive: bool,
    tax-registered: bool,
    rounding-index: int,
    can-edit: bool,
    mode-changed: bool,
    notice: Note,
}

// The section's tabs (Ctrl+1 … Ctrl+3).
component PriceTabs inherits HorizontalLayout {
    in property <string> screen;
    callback action(string);
    spacing: 6px;
    alignment: start;
    for tab in [
        { id: "tab-price-lists", keys: "Ctrl+1", label: @tr("Price lists"), on: root.screen == "price-lists" },
        { id: "tab-tax-rates", keys: "Ctrl+2", label: @tr("Tax rates"), on: root.screen == "tax-rates" },
        { id: "tab-pricing-settings", keys: "Ctrl+3", label: @tr("Pricing settings"), on: root.screen == "pricing-settings" },
    ]: TabButton {
        text: tab.label;
        keys: tab.keys;
        selected: tab.on;
        clicked => {
            root.action(tab.id);
        }
    }
}

component Head inherits Text {
    color: Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
    overflow: elide;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

// A label above a picker.
component Labelled inherits VerticalLayout {
    in property <string> label;
    in property <[string]> model;
    in property <int> index;
    in property <bool> enabled: true;
    in property <Note> error;
    callback selected(int);
    spacing: 3px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
    }
    ComboBox {
        model: root.model;
        current-index: root.index;
        enabled: root.enabled;
        accessible-label: root.label;
        selected(v) => {
            root.selected(self.current-index);
        }
    }
    if root.error.code != "": Text {
        text: BoStrings.message(root.error.code, root.error.arg);
        color: Theme.danger;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// The list editor's fields (rebuilt on `serial`).
component ListFields inherits VerticalLayout {
    in property <BoPriceListEditor> editor;
    in property <[string]> target-choices;
    in property <string> focus-target;
    callback edit(string, int, int, string, string);
    callback choose(string, int, string, int);
    callback toggle(string, int, string, bool);
    callback action(string);
    spacing: 12px;

    Timer {
        interval: 1ms;
        triggered => {
            self.running = false;
            if (root.focus-target == "price-list-name") {
                name.focus-edit();
            }
        }
    }

    if root.editor.is-default: Hint {
        text: @tr("The default list prices every item at every branch. It cannot be switched off, archived or given a rule.");
    }
    if !root.editor.is-default: Labelled {
        label: @tr("Applies to");
        model: [@tr("A branch"), @tr("A customer group"), @tr("A membership tier"), @tr("One customer (contract prices)")];
        index: root.editor.kind-index;
        enabled: root.editor.can-edit && root.editor.is-new;
        selected(i) => {
            root.choose("price-list", 0, "kind", i);
        }
    }
    if !root.editor.is-default && root.editor.is-new && root.editor.kind != "customer": Labelled {
        label: BoStrings.label("kind_" + root.editor.kind);
        model: root.target-choices;
        index: root.editor.target-index;
        enabled: root.editor.can-edit;
        error: root.editor.target-error;
        selected(i) => {
            root.choose("price-list", 0, "target", i);
        }
    }
    if !root.editor.is-default && root.editor.is-new && root.editor.kind == "customer": HorizontalLayout {
        spacing: 8px;
        Field {
            horizontal-stretch: 1;
            label: @tr("Customer: member code or phone");
            placeholder: "K7QH-29XM";
            text: root.editor.customer;
            enabled: root.editor.can-edit;
            error: root.editor.target-error;
            edited(t) => {
                root.edit("price-list", 0, 0, "customer", t);
            }
            accepted => {
                root.action("price-find-customer");
            }
        }
        VerticalLayout {
            alignment: end;
            SmallButton {
                text: @tr("Find customer");
                enabled: root.editor.can-edit;
                clicked => {
                    root.action("price-find-customer");
                }
            }
        }
    }
    if !root.editor.is-default && (!root.editor.is-new || root.editor.kind == "customer") && root.editor.target-name != "": Text {
        text: @tr("{}: {}", BoStrings.label("kind_" + root.editor.kind), root.editor.target-name);
        color: Theme.text;
        wrap: word-wrap;
    }
    name := Field {
        label: @tr("Name");
        text: root.editor.name;
        enabled: root.editor.can-edit;
        error: root.editor.name-error;
        edited(t) => {
            root.edit("price-list", 0, 0, "name", t);
        }
        accepted => {
            root.action("price-list-save");
        }
    }
    if !root.editor.is-default: CheckBox {
        text: @tr("Active (switched off: the list does not apply)");
        checked: root.editor.active;
        enabled: root.editor.can-edit;
        toggled => {
            root.toggle("price-list", 0, "active", self.checked);
        }
    }
    if !root.editor.is-default: HorizontalLayout {
        spacing: 8px;
        Labelled {
            width: 150px;
            label: @tr("List rule");
            model: [@tr("No rule"), @tr("± %"), @tr("± Rp")];
            index: root.editor.rule-index;
            enabled: root.editor.can-edit;
            selected(i) => {
                root.choose("price-list", 0, "rule", i);
            }
        }
        Field {
            horizontal-stretch: 1;
            label: root.editor.rule-index == 1 ? @tr("Percent, e.g. -5") : @tr("Rupiah, e.g. -500");
            text: root.editor.rule-value;
            enabled: root.editor.can-edit && root.editor.rule-index > 0;
            error: root.editor.rule-error;
            edited(t) => {
                root.edit("price-list", 0, 0, "rule", t);
            }
            accepted => {
                root.action("price-list-save");
            }
        }
    }
    if !root.editor.is-default: Hint {
        text: @tr("The rule prices every item without its own price in this list, from the price of the next list (e.g. Gold −5%).");
    }
}

export component PriceListsScreen inherits VerticalLayout {
    in property <string> screen;
    in property <[BoPriceListRow]> rows;
    in property <BoPriceListEditor> editor;
    in property <[string]> target-choices;
    in property <Note> read-only;
    in property <int> serial;
    in property <string> focus-target;
    callback action(string);
    callback edit(string, int, int, string, string);
    callback toggle(string, int, string, bool);
    callback choose(string, int, string, int);
    callback pick(string, int, int);
    padding: 16px;
    spacing: 12px;

    PriceTabs {
        screen: root.screen;
        action(id) => {
            root.action(id);
        }
    }
    Banner {
        note: root.read-only;
    }
    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 1px;
                HorizontalLayout {
                    height: 34px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    Head { horizontal-stretch: 2; preferred-width: 0px; text: @tr("Name"); }
                    Head { width: 130px; text: @tr("Kind"); }
                    Head { horizontal-stretch: 2; preferred-width: 0px; text: @tr("Applies to"); }
                    Head { width: 90px; text: @tr("List rule"); }
                    Head { width: 60px; text: ""; }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                ListView {
                    vertical-stretch: 1;
                    for row[i] in root.rows: Rectangle {
                        height: 38px;
                        background: i == root.editor.cursor && !root.editor.is-new ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
                        accessible-role: list-item;
                        accessible-label: row.name;
                        accessible-action-default => {
                            root.pick("price-list", i, 0);
                        }
                        touch := TouchArea {
                            clicked => {
                                root.pick("price-list", i, 0);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            Text { horizontal-stretch: 2; preferred-width: 0px; text: row.name; color: row.active ? Theme.text : Theme.muted; vertical-alignment: center; overflow: elide; font-weight: 600; }
                            Text { width: 130px; text: BoStrings.label("kind_" + row.kind); color: Theme.muted; vertical-alignment: center; overflow: elide; }
                            Text { horizontal-stretch: 2; preferred-width: 0px; text: row.kind == "default" ? @tr("Every branch") : row.target; color: Theme.text; vertical-alignment: center; overflow: elide; }
                            Text { width: 90px; text: row.rule; color: Theme.text; vertical-alignment: center; }
                            Text { width: 60px; text: row.active ? "" : @tr("off"); color: Theme.warn; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-bottom: 10px;
                    Hint {
                        text: @tr("A sale takes the first list that prices the item: the customer's contract, the tier, the group, the branch, then the default list.");
                    }
                }
            }
        }
        Card {
            width: 440px;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: start;
                SectionTitle {
                    text: root.editor.is-new ? @tr("New price list") : @tr("Edit price list");
                }
                for s in [root.serial]: ListFields {
                    editor: root.editor;
                    target-choices: root.target-choices;
                    focus-target: root.focus-target;
                    edit(k, r, x, f, v) => {
                        root.edit(k, r, x, f, v);
                    }
                    choose(k, r, f, i) => {
                        root.choose(k, r, f, i);
                    }
                    toggle(k, r, f, on) => {
                        root.toggle(k, r, f, on);
                    }
                    action(id) => {
                        root.action(id);
                    }
                }
                Banner {
                    note: root.editor.notice;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    KeyButton {
                        keys: "Ctrl+S";
                        text: @tr("Save");
                        primary: true;
                        enabled: root.editor.can-edit;
                        clicked => {
                            root.action("price-list-save");
                        }
                    }
                    if !root.editor.is-new && !root.editor.is-default: KeyButton {
                        keys: "Ctrl+Shift+A";
                        text: @tr("Archive");
                        enabled: root.editor.can-edit;
                        clicked => {
                            root.action("price-list-archive");
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    KeyButton {
                        keys: "Ctrl+N";
                        text: @tr("New list");
                        enabled: root.editor.can-edit;
                        clicked => {
                            root.action("price-list-new");
                        }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        KeyButton { keys: "↑ ↓"; text: @tr("Move"); }
        KeyButton {
            keys: "F5";
            text: @tr("Refresh");
            clicked => {
                root.action("price-refresh");
            }
        }
    }
}

// The new rate's fields (rebuilt on `serial`).
component RateFields inherits HorizontalLayout {
    in property <BoTaxRates> tax;
    in property <string> focus-target;
    callback edit(string, int, int, string, string);
    callback action(string);
    spacing: 12px;

    Timer {
        interval: 1ms;
        triggered => {
            self.running = false;
            if (root.focus-target == "tax-rate") {
                rate.focus-edit();
            }
        }
    }
    rate := Field {
        horizontal-stretch: 1;
        label: @tr("New rate (%)");
        placeholder: "12";
        text: root.tax.rate;
        enabled: root.tax.can-edit;
        error: root.tax.rate-error;
        edited(t) => {
            root.edit("tax-rate", 0, 0, "rate", t);
        }
        accepted => {
            root.action("tax-rate-add");
        }
    }
    Field {
        horizontal-stretch: 1;
        label: @tr("From (YYYY-MM-DD)");
        text: root.tax.valid-from;
        enabled: root.tax.can-edit;
        error: root.tax.from-error;
        edited(t) => {
            root.edit("tax-rate", 0, 0, "valid_from", t);
        }
        accepted => {
            root.action("tax-rate-add");
        }
    }
}

export component TaxRatesScreen inherits VerticalLayout {
    in property <string> screen;
    in property <[string]> classes;
    in property <[BoTaxRateRow]> rates;
    in property <BoTaxRates> tax;
    in property <Note> read-only;
    in property <int> serial;
    in property <string> focus-target;
    callback action(string);
    callback edit(string, int, int, string, string);
    callback pick(string, int, int);
    padding: 16px;
    spacing: 12px;

    PriceTabs {
        screen: root.screen;
        action(id) => {
            root.action(id);
        }
    }
    Banner {
        note: root.read-only;
    }
    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;
        Card {
            width: 300px;
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                SectionTitle {
                    text: @tr("Tax classes");
                }
                for name[i] in root.classes: Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: i == root.tax.cursor ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
                    accessible-role: list-item;
                    accessible-label: name;
                    accessible-action-default => {
                        root.pick("tax-class", i, 0);
                    }
                    touch := TouchArea {
                        clicked => {
                            root.pick("tax-class", i, 0);
                        }
                    }
                    Text {
                        x: 10px;
                        text: name;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                Hint {
                    text: @tr("Tax classes are set on each product (General tab).");
                }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: start;
                SectionTitle {
                    text: @tr("Rates of {}", root.tax.class-name);
                }
                Rectangle {
                    height: 1px + 32px + max(1, root.rates.length) * 34px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 1px;
                        HorizontalLayout {
                            height: 32px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Head { width: 140px; text: @tr("From"); }
                            Head { width: 100px; text: @tr("Rate"); }
                            Head { horizontal-stretch: 1; text: ""; }
                        }
                        for row in root.rates: HorizontalLayout {
                            height: 34px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text { width: 140px; text: row.valid-from; color: Theme.text; vertical-alignment: center; }
                            Text { width: 100px; text: row.rate; color: Theme.text; vertical-alignment: center; font-weight: 600; }
                            Text {
                                horizontal-stretch: 1;
                                text: BoStrings.label(row.status);
                                color: row.status == "current" ? Theme.success : row.status == "scheduled" ? Theme.accent : Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        if root.rates.length == 0: Text {
                            height: 34px;
                            text: @tr("No rate: the class counts as 0%.");
                            color: Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                SectionTitle {
                    text: @tr("Add a rate");
                }
                for s in [root.serial]: RateFields {
                    tax: root.tax;
                    focus-target: root.focus-target;
                    edit(k, r, x, f, v) => {
                        root.edit(k, r, x, f, v);
                    }
                    action(id) => {
                        root.action(id);
                    }
                }
                Hint {
                    text: @tr("A sale uses the rate with the latest first day on or before the sale date, so a rate change can be entered ahead of time. A rate for a day that already has one replaces it.");
                }
                Banner {
                    note: root.tax.notice;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    KeyButton {
                        keys: "Ctrl+S";
                        text: @tr("Add rate");
                        primary: true;
                        enabled: root.tax.can-edit;
                        clicked => {
                            root.action("tax-rate-add");
                        }
                    }
                    KeyButton { keys: "↑ ↓"; text: @tr("Tax class"); }
                }
            }
        }
    }
}

export component PricingSettingsScreen inherits VerticalLayout {
    in property <string> screen;
    in property <BoPricingSettings> settings;
    in property <Note> read-only;
    callback action(string);
    callback toggle(string, int, string, bool);
    callback choose(string, int, string, int);
    padding: 16px;
    spacing: 12px;

    PriceTabs {
        screen: root.screen;
        action(id) => {
            root.action(id);
        }
    }
    Banner {
        note: root.read-only;
    }
    HorizontalLayout {
        alignment: start;
        vertical-stretch: 1;
        Card {
            width: 600px;
            height: box.preferred-height;
            box := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                SectionTitle {
                    text: @tr("Pricing settings");
                }
                CheckBox {
                    text: @tr("Prices include tax (PPN)");
                    checked: root.settings.tax-inclusive;
                    enabled: root.settings.can-edit;
                    toggled => {
                        root.toggle("pricing-settings", 0, "tax_inclusive", self.checked);
                    }
                }
                Hint {
                    text: @tr("On: a price of Rp 11.100 includes Rp 1.100 PPN. Off: the PPN is added on top. Every price follows this setting.");
                }
                if root.settings.mode-changed: Rectangle {
                    border-radius: 8px;
                    background: Theme.danger-soft;
                    height: warning.preferred-height + 16px;
                    warning := Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: @tr("Stored prices are not converted: every price keeps its amount and is read the new way. Check your prices after saving.");
                        color: Theme.warn;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: @tr("Tax-registered (PKP)");
                    checked: root.settings.tax-registered;
                    enabled: root.settings.can-edit;
                    toggled => {
                        root.toggle("pricing-settings", 0, "tax_registered", self.checked);
                    }
                }
                Hint {
                    text: @tr("Off: no tax is computed or printed, and prices are charged as entered.");
                }
                Labelled {
                    label: @tr("Cash rounding");
                    model: [@tr("None"), @tr("To the nearest Rp 100"), @tr("Down to Rp 100"), @tr("To the nearest Rp 500"), @tr("Down to Rp 500")];
                    index: root.settings.rounding-index;
                    enabled: root.settings.can-edit;
                    selected(i) => {
                        root.choose("pricing-settings", 0, "cash_rounding", i);
                    }
                }
                Hint {
                    text: @tr("Applies only when cash pays the rest of a sale; card and QRIS pay the exact amount.");
                }
                Banner {
                    note: root.settings.notice;
                }
                HorizontalLayout {
                    alignment: start;
                    KeyButton {
                        keys: "Ctrl+S";
                        text: @tr("Save");
                        primary: true;
                        enabled: root.settings.can-edit;
                        clicked => {
                            root.action("pricing-settings-save");
                        }
                    }
                }
            }
        }
    }
}
