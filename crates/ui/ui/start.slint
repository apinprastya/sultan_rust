// The Start screen of a single app or a terminal (`crates/ui/src/start.rs` decides everything;
// `start_app.rs` sets these properties and receives the callbacks): big tiles for the cash
// register (F1), the back office (F2) and the settings (F3), and a footer that says what this
// computer is connected to. Settings: language (F6), connection details, set up again (F8),
// version, and on a single app "Terminals in this shop" (F7 or the switch). One FocusScope hands every key to Rust; tiles and chips are buttons for the same
// actions.

import { Theme } from "theme.slint";
import { Note, Chip, Card, KeyChip } from "widgets.slint";

export global StartStrings {
    public pure function message(code: string, arg: string) -> string {
        if (code == "") {
            return "";
        }
        if (code == "network") {
            return @tr("Cannot reach the server at {}. Check the network cable or Wi-Fi and that the server is switched on, then press F5.", arg);
        }
        if (code == "unpaired") {
            return @tr("The server does not know this register any more (it was unpaired). Open Settings and choose Set up again.");
        }
        if (code == "file") {
            return @tr("Cannot save the settings: {}", arg);
        }
        if (code == "lan_failed") {
            return @tr("Terminals could not be switched: {}. The previous setting stays.", arg);
        }
        if (code == "lan_in_use") {
            return @tr("Port {} is already used by another program on this computer. The previous setting stays.", arg);
        }
        if (code == "lan_start") {
            return @tr("Terminals cannot connect: port {} could not be opened on this computer (another program may use it), so only this computer uses its server now. Switch terminals on again in Settings.", arg);
        }
        return @tr("Something went wrong ({}).", arg);
    }

    public pure function chip(code: string) -> string {
        if (code == "register") {
            return @tr("Cash register");
        }
        if (code == "backoffice") {
            return @tr("Back office");
        }
        if (code == "settings") {
            return @tr("Settings");
        }
        if (code == "check_connection") {
            return @tr("Check connection");
        }
        if (code == "change_language") {
            return @tr("Change language");
        }
        if (code == "set_up_again") {
            return @tr("Set up again");
        }
        if (code == "terminals") {
            return @tr("Allow terminals");
        }
        if (code == "back") {
            return @tr("Back");
        }
        if (code == "continue") {
            return @tr("Continue");
        }
        if (code == "cancel") {
            return @tr("Cancel");
        }
        return code;
    }

    // The connection line: `kind` single / terminal, `conn` checking / ok / unpaired / failed.
    public pure function connection(kind: string, conn: string, server: string) -> string {
        if (conn == "checking") {
            return @tr("Connecting to {}…", server);
        }
        if (conn == "failed") {
            return @tr("Not connected to {}", server);
        }
        if (conn == "unpaired") {
            return @tr("Connected to {}, but this register is not paired", server);
        }
        if (kind == "single") {
            return @tr("Single app: the server runs on this computer");
        }
        return @tr("Connected to {}", server);
    }
}

// One line of feedback in the Start screen's words; empty when there is nothing to say.
component StartNote inherits Text {
    in property <Note> note;
    text: StartStrings.message(root.note.code, root.note.arg);
    color: Theme.tone-color(root.note.tone);
    font-size: 15px;
    wrap: word-wrap;
    horizontal-alignment: center;
}

component Tile inherits Rectangle {
    in property <string> keys;
    in property <string> title;
    in property <string> description;
    callback clicked;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    border-radius: 18px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    background: touch.pressed ? Theme.accent-soft : touch.has-hover ? Theme.raised : Theme.panel;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 40px;
                min-width: 64px;
                border-radius: 9px;
                background: Theme.accent-soft;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.keys;
                        color: Theme.accent;
                        font-size: 20px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 28px;
            font-weight: 700;
            wrap: word-wrap;
        }
        Text {
            text: root.description;
            color: Theme.muted;
            font-size: 15px;
            wrap: word-wrap;
        }
    }
}

component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    height: 44px;
    min-width: label.preferred-width + 40px;
    border-radius: 10px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: root.selected ? Theme.accent-soft : touch.has-hover && root.enabled ? Theme.raised : Theme.panel;
    opacity: root.enabled || root.selected ? 1 : 0.5;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        text: root.text;
        color: root.selected ? Theme.text : Theme.muted;
        font-size: 16px;
        font-weight: root.selected ? 700 : 400;
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text;
    spacing: 16px;
    Text {
        width: 180px;
        text: root.label;
        color: Theme.muted;
        vertical-alignment: top;
    }
    // Wraps rather than cut off: the status text is long in Indonesian at 1024×768.
    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: root.value-color;
        font-weight: 600;
        vertical-alignment: top;
        wrap: word-wrap;
    }
}

// An on / off switch with its label; a tap or the default action switches it.
component Switch inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    height: 48px;
    opacity: root.enabled ? 1 : 0.5;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 30px;
                border-radius: 15px;
                background: root.on ? Theme.accent : Theme.key;
                border-width: 1px;
                border-color: touch.has-hover && root.enabled ? Theme.accent : Theme.border;
                Rectangle {
                    x: root.on ? parent.width - self.width - 4px : 4px;
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: white;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 17px;
    font-weight: 700;
}

export component StartWindow inherits Window {
    title: @tr("Sultan POS · Start");
    preferred-width: 1366px;
    preferred-height: 768px;
    min-width: 1024px;
    min-height: 640px;
    background: Theme.bg;
    default-font-size: 15px;
    forward-focus: keys;

    in property <string> page: "home";
    in property <bool> confirm;
    // single / terminal.
    in property <string> kind;
    // checking / ok / unpaired / failed.
    in property <string> conn;
    // The server as shown, e.g. 192.168.1.10:8080.
    in property <string> server;
    in property <string> register-code;
    in property <string> register-name;
    in property <string> branch;
    in property <string> version;
    in property <string> language;
    in property <bool> language-fixed;
    // A single app: the "Terminals in this shop" section.
    in property <bool> lan-shown;
    in property <bool> lan-on;
    // SULTAN_LISTEN sets the address: the switch is locked.
    in property <bool> lan-fixed;
    // The server is being restarted on the new address.
    in property <bool> lan-busy;
    in property <string> lan-port;
    // What terminals type in their wizard, one per line; empty: none found.
    in property <string> lan-addresses;
    in property <Note> note;
    // The footer's key chips (the home tiles carry their own keys).
    in property <[Chip]> chips;
    out property <bool> has-focus: keys.has-focus;

    callback key(string, bool, bool) -> bool;
    callback action(string);
    callback pump();

    // The texts as shown, in the current language (used by the headless tests).
    public pure function message(note: Note) -> string {
        return StartStrings.message(note.code, note.arg);
    }
    public pure function connection-text() -> string {
        return StartStrings.connection(root.kind, root.conn, root.server);
    }

    property <color> conn-color: root.conn == "ok" ? Theme.success : root.conn == "checking" ? Theme.warn : Theme.danger;
    property <string> register-text: root.register-code + " " + root.register-name;

    keys := FocusScope {
        key-pressed(e) => {
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Header.
            Rectangle {
                height: 60px;
                background: Theme.panel;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 9px;
                            background: Theme.accent;
                            Text {
                                text: "S";
                                color: white;
                                font-size: 18px;
                                font-weight: 800;
                            }
                        }
                    }
                    Text {
                        text: "Sultan";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.branch;
                        color: Theme.muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.register-text;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                if root.page == "home": VerticalLayout {
                    padding: 32px;
                    spacing: 22px;
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("What do you want to open?");
                            color: Theme.text;
                            font-size: 26px;
                            font-weight: 700;
                        }
                        Text {
                            text: @tr("Press a key or tap a tile.");
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                    tiles := HorizontalLayout {
                        spacing: 20px;
                        height: min(360px, max(220px, parent.height * 0.55));
                        Tile {
                            // Equal widths, whatever the text.
                            width: (tiles.width - 40px) / 3;
                            keys: "F1";
                            title: StartStrings.chip("register");
                            description: @tr("Sell: each cashier logs in with their PIN.");
                            clicked => {
                                root.action("register");
                            }
                        }
                        Tile {
                            // Equal widths, whatever the text.
                            width: (tiles.width - 40px) / 3;
                            keys: "F2";
                            title: StartStrings.chip("backoffice");
                            description: @tr("Products, categories and brands: log in with your username and password.");
                            clicked => {
                                root.action("backoffice");
                            }
                        }
                        Tile {
                            // Equal widths, whatever the text.
                            width: (tiles.width - 40px) / 3;
                            keys: "F3";
                            title: StartStrings.chip("settings");
                            description: @tr("Language, connection and setting this computer up again.");
                            clicked => {
                                root.action("settings");
                            }
                        }
                    }
                    StartNote {
                        note: root.note;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }

                if root.page == "settings": VerticalLayout {
                    padding: 24px;
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 16px;
                    // The title, and any message beside it (the page is full at 1024×768).
                    HorizontalLayout {
                        spacing: 24px;
                        Text {
                            text: StartStrings.chip("settings");
                            color: Theme.text;
                            font-size: 26px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        StartNote {
                            horizontal-stretch: 1;
                            note: root.note;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 16px;
                            alignment: start;
                            Card {
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    SectionTitle {
                                        text: @tr("Language");
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;
                                        Choice {
                                            text: "Bahasa Indonesia";
                                            selected: root.language == "id";
                                            enabled: !root.language-fixed;
                                            clicked => {
                                                root.action("lang-id");
                                            }
                                        }
                                        Choice {
                                            text: "English";
                                            selected: root.language == "en";
                                            enabled: !root.language-fixed;
                                            clicked => {
                                                root.action("lang-en");
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.language-fixed ? @tr("Set by SULTAN_LANG on this computer.") : @tr("F6 switches. Saved for the next start.");
                                        color: Theme.muted;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            Card {
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 6px;
                                    SectionTitle {
                                        text: @tr("Connection");
                                    }
                                    InfoRow {
                                        label: @tr("App type");
                                        value: root.kind == "single" ? @tr("Single app") : @tr("Terminal");
                                    }
                                    InfoRow {
                                        // A single app's own server, not the address terminals type
                                        // (that one is in "Terminals in this shop").
                                        label: root.kind == "single" ? @tr("This computer's address") : @tr("Server address");
                                        value: root.server;
                                    }
                                    InfoRow {
                                        label: StartStrings.chip("register");
                                        value: root.register-text;
                                    }
                                    InfoRow {
                                        label: @tr("Branch");
                                        value: root.branch == "" ? "–" : root.branch;
                                    }
                                    InfoRow {
                                        label: @tr("Status");
                                        value: root.connection-text();
                                        value-color: root.conn-color;
                                    }
                                    InfoRow {
                                        label: @tr("Version");
                                        value: "Sultan POS " + root.version;
                                    }
                                }
                            }
                            Card {
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 8px;
                                    SectionTitle {
                                        text: StartStrings.chip("set_up_again");
                                    }
                                    Text {
                                        text: @tr("F8 opens the setup wizard, e.g. to make this computer a terminal of another server. A database that is already set up is never overwritten.");
                                        color: Theme.muted;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        if root.lan-shown: Card {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                alignment: start;
                                SectionTitle {
                                    text: @tr("Terminals in this shop");
                                }
                                Text {
                                    text: @tr("Other cash registers (terminals) on the shop network can use this computer's server.");
                                    color: Theme.muted;
                                    wrap: word-wrap;
                                }
                                Switch {
                                    text: @tr("Allow terminals to connect");
                                    on: root.lan-on;
                                    enabled: !root.lan-fixed && !root.lan-busy;
                                    clicked => {
                                        root.action("lan");
                                    }
                                }
                                Text {
                                    text: root.lan-busy ? @tr("Restarting the server…") : root.lan-fixed ? @tr("Set by SULTAN_LISTEN on this computer.") : @tr("F7 switches. Saved for the next start.");
                                    color: root.lan-busy ? Theme.warn : Theme.muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                if root.lan-on && root.lan-addresses != "": VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: @tr("In the terminal's setup wizard, type this server address:");
                                        color: Theme.text;
                                        wrap: word-wrap;
                                    }
                                    Rectangle {
                                        border-radius: 10px;
                                        background: Theme.raised;
                                        VerticalLayout {
                                            padding: 12px;
                                            padding-left: 16px;
                                            Text {
                                                text: root.lan-addresses;
                                                color: Theme.text;
                                                font-size: 22px;
                                                font-weight: 700;
                                            }
                                        }
                                    }
                                }
                                if root.lan-on && root.lan-addresses == "": Text {
                                    text: @tr("No network address was found on this computer. Connect it to the shop network, then open Settings again.");
                                    color: Theme.warn;
                                    wrap: word-wrap;
                                }
                                if !root.lan-on: Text {
                                    text: @tr("Off: only this computer uses its server. Turn it on to add terminals.");
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: @tr("Terminals still need a manager login or a pairing code to connect. Turn this on only in a trusted shop network.");
                                    color: Theme.muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: @tr("If a terminal cannot connect, allow incoming TCP port {} in this computer's firewall.", root.lan-port);
                                    color: Theme.muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }

            // Footer: the connection and the key chips.
            Rectangle {
                height: 60px;
                background: Theme.panel;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.conn-color;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.connection-text() + " · " + root.register-text + (root.branch == "" ? "" : " · " + root.branch);
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    for c in root.chips: KeyChip {
                        keys: c.keys;
                        label: StartStrings.chip(c.label);
                        clicked => {
                            root.action(c.id);
                        }
                    }
                }
            }
        }

        if root.confirm: Rectangle {
            background: Theme.scrim;
            TouchArea { }
            Card {
                width: min(560px, parent.width - 48px);
                height: dialog.preferred-height;
                background: Theme.raised;
                dialog := VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    Text {
                        text: @tr("Open the setup wizard?");
                        color: Theme.text;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: @tr("This window closes while the wizard is open. A database that is already set up is never overwritten; closing the wizard brings you back here.");
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        KeyChip {
                            keys: "Esc";
                            label: StartStrings.chip("cancel");
                            clicked => {
                                root.action("back");
                            }
                        }
                        KeyChip {
                            keys: "Enter";
                            label: StartStrings.chip("continue");
                            clicked => {
                                root.action("confirm");
                            }
                        }
                    }
                }
            }
        }
    }
}
