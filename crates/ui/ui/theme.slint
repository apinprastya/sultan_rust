        if (code == "no_tender_types") {
            return @tr("Loading the tender types. Try again.");
        }
        if (code == "cart_not_empty") {
            return @tr("Finish or void the cart first.");
        }
        if (code == "drawer_opened") {
            return @tr("Drawer opened.");
        }
        if (code == "cart_held") {
            return @tr("The cart is on hold. Shift+F11 resumes it.");
        }
        if (code == "hold_first") {
            return @tr("Hold the current cart first (type a note or press Enter).");
        }
        if (code == "cart_taken") {
            return @tr("Another register took this cart already. The list is up to date.");
        }
        if (code == "held_deleted") {
            return @tr("The held cart was deleted.");
        }
        if (code == "cart_resumed") {
            return @tr("Cart resumed ({} lines). Prices were checked again.", arg);
        }
        if (code == "held_unreadable") {
            return @tr("This held cart cannot be read.");
        }
        if (code == "reprinted") {
            return @tr("Copy of {} printed.", arg);
        }
        if (code == "sale_voided") {
            return @tr("Sale {} voided.", arg);
        }
        if (code == "has_returns") {
            return @tr("This sale has returns, so it cannot be voided. Return the rest instead.");
        }
        if (code == "sessions_open") {
            return @tr("Sessions of this day are still open: {}. Close them first.", arg);
