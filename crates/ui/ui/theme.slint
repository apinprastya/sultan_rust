        }
        if (code == "return_lines") {
            return @tr("Return: pick the items");
        }
        if (code == "return_no_receipt") {
            return @tr("Return without receipt");
        }
        if (code == "return_done") {
            return @tr("Return posted");
        }
        if (code == "write_off") {
            return @tr("Write off: why?");
        }
        if (code == "return_qty") {
            return @tr("Return: how many?");
        }
        if (code == "refund_total") {
            return @tr("REFUND");
        }
        if (code == "cash_back") {
            return @tr("CASH TO PAY BACK");
        }
        return code;
    }

    // Placeholders of the sell dialogs' typed field (phase S5).
    public pure function placeholder(code: string) -> string {
        if (code == "receipt_number") {
            return @tr("Type or scan a receipt number");
        }
        if (code == "item_code") {
            return @tr("Scan or type the returned item");
        }
        if (code == "note") {
            return @tr("A note for the held cart");
        }
        if (code == "write_off") {
            return @tr("Why is it written off?");
        }
        if (code == "return_qty") {
            return @tr("Quantity to return (a decimal comma for weighed items)");
        }
        return "";
    }

    // Void reasons (spec 2.6 §3).
    public pure function void-reason(code: string) -> string {
        if (code == "customer_changed_mind") {
            return @tr("Customer changed their mind");
        }
        if (code == "wrong_item") {
            return @tr("Wrong item");
        }
        if (code == "price_dispute") {
            return @tr("Price dispute");
        }
        if (code == "other") {
            return @tr("Other (type it)");
        }
        return code;
    }

    // How a cart line is priced (`crates/ui/src/app.rs` `cart_rows`).
    public pure function line-flag(code: string) -> string {
        if (code == "override") {
            return @tr("Manual price");
        }
        if (code == "open") {
            return @tr("Open price");
        }
        if (code == "label") {
            return @tr("Scale label");
        }
        if (code == "no_price") {
            return @tr("No price");
        }
        return code;
    }

    // Product types (spec 2.2 §5).
    public pure function product-type(code: string) -> string {
        if (code == "stock") {
            return @tr("Stock");
        }
        if (code == "weighed") {
            return @tr("Weighed");
        }
        if (code == "service") {
            return @tr("Service");
        }
        if (code == "bundle") {
            return @tr("Bundle");
        }
        return code;
    }

    // Close-report rows and tenders.
    public pure function label(code: string) -> string {
        if (code == "opening_cash") {
            return @tr("Opening cash");
        }
        if (code == "cash_sales") {
            return @tr("Cash sales");
        }
        if (code == "cash_refunds") {
            return @tr("Cash refunds");
        }
        if (code == "cash_in") {
            return @tr("Cash in");
        }
        if (code == "cash_out") {
            return @tr("Cash out");
        }
        if (code == "expected_cash") {
            return @tr("Expected cash");
        }
        if (code == "counted_cash") {
            return @tr("Counted cash");
        }
        if (code == "transactions") {
            return @tr("Transactions");
        }
        if (code == "float_kept") {
            return @tr("Kept as float");
        }
        if (code == "to_safe") {
            return @tr("To the safe");
        }
        if (code == "cash") {
            return @tr("Cash");
        }
        if (code == "card") {
            return @tr("Card");
        }
        if (code == "qris") {
            return "QRIS";
        }
        if (code == "transfer") {
            return @tr("Bank transfer");
        }
        return code;
    }
}
