            return @tr("Manual price");
        }
        if (code == "sale.void_line") {
            return @tr("Void a line");
        }
        if (code == "sale.void") {
            return @tr("Void the cart");
        }
        if (code == "sale.post_void") {
            return @tr("Void a paid sale");
        }
        if (code == "sale.reprint") {
            return @tr("Reprint a receipt");
        }
        if (code == "refund.with_receipt") {
            return @tr("Return after the return window");
        }
        if (code == "drawer.open") {
            return @tr("Open the drawer");
        }
        if (code == "cash.in") {
            return @tr("Cash in");
        }
        if (code == "cash.drop") {
            return @tr("Safe drop");
        }
        if (code == "day.close") {
            return @tr("End of day (Z)");
        }
        if (code == "session.view_expected") {
            return @tr("X report (expected cash)");
        }
        return code;
    }

    // How a scanned code matched (`crates/ui/src/scan.rs` `match_kind`).
    public pure function match-kind(code: string) -> string {
        if (code == "barcode") {
            return @tr("Barcode");
        }
        if (code == "normalized_barcode") {
            return @tr("Barcode (UPC/EAN form)");
        }
        if (code == "scale_weight") {
            return @tr("Scale label (weight)");
        }
        if (code == "scale_price") {
            return @tr("Scale label (price)");
        }
        if (code == "sku") {
            return "SKU";
        }
        if (code == "plu") {
            return "PLU";
        }
        return code;
    }

    // Where a customer price comes from (a price list's kind, spec 2.3 §2); `name` is the
    // customer's tier or group.
    public pure function price-source(kind: string, name: string) -> string {
        if (kind == "customer") {
            return @tr("Contract price for this customer");
        }
        if (kind == "tier") {
            return name != "" ? @tr("{} member price", name) : @tr("Member tier price");
        }
        if (kind == "group") {
            return name != "" ? @tr("{} group price", name) : @tr("Customer group price");
        }
        if (kind == "branch") {
            return @tr("This branch’s price");
        }
        if (kind == "default") {
            return @tr("Default store price");
        }
        return kind;
    }

