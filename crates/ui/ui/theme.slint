        }
        if (code == "return_window") {
            return @tr("The sale is older than the return window. A manager must approve.");
        }
        if (code == "already_voided") {
            return @tr("This sale is voided or was changed meanwhile.");
        }
        if (code == "receipt_not_found") {
            return @tr("No sale with this receipt number.");
        }
        if (code == "other_branch_sale") {
            return @tr("This sale is not from this branch (or cannot be returned here).");
        }
        if (code == "return_no_receipt") {
            return @tr("A return has no receipt to show.");
        }
        if (code == "exchange_started") {
            return @tr("Exchange: credit {}. Scan the new items, then pay.", arg);
        }
        if (code == "exchange_cancelled") {
            return @tr("The exchange was cancelled.");
        }
        if (code == "cart_restored") {
            return @tr("The cart was restored ({} lines).", arg);
        }
        return @tr("Something went wrong ({}).", arg);
    }

