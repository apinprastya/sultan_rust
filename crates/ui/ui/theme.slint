        if (code == "nothing_to_close") {
            return @tr("Every closed session of this day is in a Z already.");
        }
        if (code == "already_reversed") {
            return @tr("This cash movement was reversed already.");
        }
        if (code == "photo_limit") {
            return @tr("A cash movement has at most 3 nota photos.");
        }
        if (code == "pick_reason") {
            return @tr("Pick a reason (↑ ↓).");
        }
        if (code == "note_required") {
            return @tr("Type a note: this needs one.");
        }
        if (code == "cannot_reverse") {
            return @tr("This movement cannot be reversed (it is a reversal itself, or of another session).");
        }
        if (code == "cash_posted") {
            return @tr("Cash movement {} posted. The slip is on the right.", arg);
        }
        if (code == "cash_reversed") {
            return @tr("Reversal {} posted.", arg);
        }
        if (code == "float_above_count") {
            return @tr("The float cannot be more than the counted cash ({}).", arg);
