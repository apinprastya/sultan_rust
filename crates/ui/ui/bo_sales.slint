// The back office's sales screens (spec 2.6, phase S6): the sales and returns lists with their
// details, the tender types and the sales settings (F8, tabs Ctrl+1 … Ctrl+4), and the customer
// form's purchase history (Ctrl+H). Rust (`crates/ui/src/backoffice/sales.rs`) decides
// everything; these components show it and report edits and clicks like the other screens.
//
// Text fields are rebuilt when Rust bumps `serial`.

import { ComboBox, CheckBox, ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Note, Card } from "widgets.slint";
import { BoStrings, Field, SmallButton, KeyButton, Banner, SectionTitle } from "bo_widgets.slint";
import { TabButton } from "bo_form.slint";

export struct BoDocRow {
    number: string,
    time: string,
    place: string,
    cashier: string,
    customer: string,
    total: string,
    status: string,
    kind: string,
}

export struct BoDocList {
    cursor: int,
    loading: bool,
    more: bool,
    notice: Note,
    empty: bool,
}

export struct BoSalesFilters {
    branch-index: int,
    register-index: int,
    from: string,
    until: string,
    customer: string,
    number: string,
    status-index: int,
    date-error: Note,
}

export struct BoFact {
    label: string,
    value: string,
    raw: bool,
    tone: int,
}

export struct BoSalesDetail {
    title: string,
    voided: bool,
    loading: bool,
    notice: Note,
    cursor: int,
}

export struct BoTenderRow {
    name: string,
    kind: string,
    needs-reference: bool,
    opens-drawer: bool,
    active: bool,
    archived: bool,
}

export struct BoTenderEditor {
    cursor: int,
    is-new: bool,
    name: string,
    kind-index: int,
    needs-reference: bool,
    opens-drawer: bool,
    active: bool,
    sort: string,
    archived: bool,
    can-edit: bool,
    notice: Note,
}

export struct BoSalesSettings {
    return-days: string,
    nota-flag-above: string,
    can-edit: bool,
    loaded: bool,
    notice: Note,
}

export struct BoWidthRow {
    branch: string,
    index: int,
}

// The section's tabs (Ctrl+1 … Ctrl+4).
component SalesTabs inherits HorizontalLayout {
    in property <string> screen;
    callback action(string);
    spacing: 6px;
    alignment: start;
    for tab in [
        { id: "tab-sales", keys: "Ctrl+1", label: @tr("Sales"), on: root.screen == "sales" || root.screen == "sale-detail" },
        { id: "tab-returns", keys: "Ctrl+2", label: @tr("Returns"), on: root.screen == "returns" || root.screen == "return-detail" },
        { id: "tab-tender-types", keys: "Ctrl+3", label: @tr("Tender types"), on: root.screen == "tender-types" },
        { id: "tab-sales-settings", keys: "Ctrl+4", label: @tr("Sales settings"), on: root.screen == "sales-settings" },
    ]: TabButton {
        text: tab.label;
        keys: tab.keys;
        selected: tab.on;
        clicked => {
            root.action(tab.id);
        }
    }
}

component Head inherits Text {
    color: Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
    overflow: elide;
}

component Cell inherits Text {
    color: Theme.text;
    font-size: 13px;
    vertical-alignment: center;
    overflow: elide;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

// A label above a picker.
component Picker inherits VerticalLayout {
    in property <string> label;
    in property <[string]> model;
    in property <int> index;
    in property <bool> enabled: true;
    callback selected(int);
    spacing: 3px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
    }
    ComboBox {
        model: root.model;
        current-index: root.index;
        enabled: root.enabled;
        accessible-label: root.label;
        selected(v) => {
            root.selected(self.current-index);
        }
    }
}

// The status of a document row: VOID in red, the others muted.
component Status inherits Text {
    in property <string> status;
    text: root.status == "voided" ? @tr("VOID") : root.status == "exchange" ? @tr("Exchange") : root.status == "no_receipt" ? @tr("No receipt") : root.status == "return" ? @tr("Return") : @tr("Posted");
    color: root.status == "voided" ? Theme.danger : Theme.muted;
    font-size: 12px;
    font-weight: root.status == "voided" ? 700 : 400;
    vertical-alignment: center;
    horizontal-alignment: right;
}

// A table of documents with "load more" under it.
component DocTable inherits Card {
    in property <[BoDocRow]> rows;
    in property <BoDocList> list;
    in property <string> pick-kind;
    in property <bool> show-cashier: true;
    in property <string> customer-head: @tr("Customer");
    callback pick(string, int, int);
    callback action(string);
    VerticalLayout {
        padding: 1px;
        HorizontalLayout {
            height: 34px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            Head { width: 190px; text: @tr("Number"); }
            Head { width: 120px; text: @tr("Date and time"); }
            Head { width: 90px; text: @tr("Branch / register"); }
            if root.show-cashier: Head { width: 100px; text: @tr("Cashier"); }
            Head { horizontal-stretch: 1; preferred-width: 0px; text: root.customer-head; }
            Head { width: 100px; text: @tr("Total"); horizontal-alignment: right; }
            Head { width: 70px; text: @tr("Status"); horizontal-alignment: right; }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        ListView {
            vertical-stretch: 1;
            for row[i] in root.rows: Rectangle {
                height: 36px;
                background: i == root.list.cursor ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
                accessible-role: list-item;
                accessible-label: row.number;
                accessible-action-default => {
                    root.pick(root.pick-kind, i, 0);
                }
                touch := TouchArea {
                    clicked => {
                        root.pick(root.pick-kind, i, 0);
                    }
                    double-clicked => {
                        root.pick(root.pick-kind, i, 0);
                        root.action("sales-open");
                    }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    Cell { width: 190px; text: (row.kind == "return" ? "↩ " : "") + row.number; font-weight: 600; }
                    Cell { width: 120px; text: row.time; color: Theme.muted; }
                    Cell { width: 90px; text: row.place; color: Theme.muted; }
                    if root.show-cashier: Cell { width: 100px; text: row.cashier; }
                    Cell { horizontal-stretch: 1; preferred-width: 0px; text: row.customer; }
                    Cell { width: 100px; text: row.total; horizontal-alignment: right; color: row.status == "voided" ? Theme.muted : Theme.text; }
                    Status { width: 70px; status: row.status; }
                }
            }
        }
        if root.list.empty: Hint {
            x: 14px;
            text: @tr("Nothing found.");
        }
        HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            alignment: start;
            KeyButton {
                keys: "Enter";
                text: @tr("Open");
                enabled: root.rows.length > 0;
                clicked => {
                    root.action("sales-open");
                }
            }
            if root.list.more: KeyButton {
                keys: "Ctrl+L";
                text: root.list.loading ? @tr("Loading…") : @tr("Load more");
                clicked => {
                    root.action("sales-more");
                }
            }
            KeyButton {
                keys: "F5";
                text: @tr("Refresh");
                clicked => {
                    root.action("sales-refresh");
                }
            }
        }
    }
}

// The filters of the lists (two rows, so they fit 1024 px).
component FiltersBar inherits VerticalLayout {
    in property <BoSalesFilters> filters;
    in property <[string]> branch-choices;
    in property <[string]> register-choices;
    in property <bool> sales;
    callback edit(string, int, int, string, string);
    callback choose(string, int, string, int);
    callback action(string);
    spacing: 8px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Picker {
            width: 170px;
            label: @tr("Branch");
            model: root.branch-choices;
            index: root.filters.branch-index;
            selected(i) => {
                root.choose("sales-filter", 0, "branch", i);
            }
        }
        Picker {
            width: 170px;
            label: @tr("Register code");
            model: root.register-choices;
            index: root.filters.register-index;
            selected(i) => {
                root.choose("sales-filter", 0, "register", i);
            }
        }
        if root.sales: Picker {
            width: 170px;
            label: @tr("Status");
            model: [@tr("All"), @tr("Posted"), @tr("VOID")];
            index: root.filters.status-index;
            selected(i) => {
                root.choose("sales-filter", 0, "status", i);
            }
        }
        Field {
            width: 150px;
            label: @tr("From");
            placeholder: "YYYY-MM-DD";
            text: root.filters.from;
            error: root.filters.date-error.arg == "from" ? root.filters.date-error : { };
            edited(t) => {
                root.edit("sales-filter", 0, 0, "from", t);
            }
            accepted => {
                root.action("sales-search");
            }
        }
        Field {
            width: 150px;
            label: @tr("Until");
            placeholder: "YYYY-MM-DD";
            text: root.filters.until;
            error: root.filters.date-error.arg == "until" ? root.filters.date-error : { };
            edited(t) => {
                root.edit("sales-filter", 0, 0, "until", t);
            }
            accepted => {
                root.action("sales-search");
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Field {
            width: 220px;
            label: @tr("Customer");
            placeholder: @tr("Member code or phone");
            text: root.filters.customer;
            edited(t) => {
                root.edit("sales-filter", 0, 0, "customer", t);
            }
            accepted => {
                root.action("sales-search");
            }
        }
        Field {
            width: 240px;
            label: @tr("Number");
            text: root.filters.number;
            edited(t) => {
                root.edit("sales-filter", 0, 0, "number", t);
            }
            accepted => {
                root.action("sales-search");
            }
        }
        VerticalLayout {
            alignment: end;
            HorizontalLayout {
                spacing: 6px;
                SmallButton {
                    text: @tr("Search");
                    primary: true;
                    clicked => {
                        root.action("sales-search");
                    }
                }
                SmallButton {
                    text: @tr("Clear");
                    clicked => {
                        root.action("sales-clear");
                    }
                }
            }
        }
    }
}

// Sales (Ctrl+1) or returns (Ctrl+2).
export component SalesListScreen inherits VerticalLayout {
    in property <string> screen;
    in property <BoSalesFilters> filters;
    in property <[string]> branch-choices;
    in property <[string]> register-choices;
    in property <[BoDocRow]> rows;
    in property <BoDocList> list;
    in property <int> serial;
    callback action(string);
    callback edit(string, int, int, string, string);
    callback choose(string, int, string, int);
    callback pick(string, int, int);
    padding: 16px;
    spacing: 12px;

    SalesTabs {
        screen: root.screen;
        action(id) => {
            root.action(id);
        }
    }
    for s in [root.serial]: FiltersBar {
        filters: root.filters;
        branch-choices: root.branch-choices;
        register-choices: root.register-choices;
        sales: root.screen == "sales";
        edit(k, r, x, f, v) => {
            root.edit(k, r, x, f, v);
        }
        choose(k, r, f, i) => {
            root.choose(k, r, f, i);
        }
        action(id) => {
            root.action(id);
        }
    }
    Banner {
        note: root.list.notice;
    }
    DocTable {
        vertical-stretch: 1;
        rows: root.rows;
        list: root.list;
        pick-kind: root.screen == "sales" ? "sale-row" : "return-row";
        pick(k, r, s) => {
            root.pick(k, r, s);
        }
        action(id) => {
            root.action(id);
        }
    }
}

// One sale or return: its facts, linked documents and the receipt.
export component SalesDetailScreen inherits VerticalLayout {
    in property <string> screen;
    in property <BoSalesDetail> detail;
    in property <[BoFact]> facts;
    in property <[BoDocRow]> links;
    in property <[string]> receipt;
    callback action(string);
    callback pick(string, int, int);
    padding: 16px;
    spacing: 12px;

    SalesTabs {
        screen: root.screen;
        action(id) => {
            root.action(id);
        }
    }
    Banner {
        note: root.detail.notice;
    }
    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    SectionTitle {
                        text: (root.screen == "sale-detail" ? @tr("Sale") : @tr("Return")) + " " + root.detail.title;
                        vertical-alignment: center;
                    }
                    if root.detail.voided: Text {
                        text: @tr("VOID");
                        color: Theme.danger;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
                if root.detail.loading: Hint {
                    text: @tr("Loading…");
                }
                ListView {
                    vertical-stretch: 1;
                    for f in root.facts: HorizontalLayout {
                        height: 26px;
                        spacing: 10px;
                        Text {
                            width: 200px;
                            text: f.raw ? f.label : BoStrings.label(f.label);
                            color: f.raw ? Theme.text : Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: f.value;
                            color: f.tone < 0 ? Theme.danger : Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                if root.links.length > 0: SectionTitle {
                    text: root.screen == "sale-detail" ? @tr("Returns of this sale") : @tr("Linked sales");
                }
                for l[i] in root.links: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: i == root.detail.cursor ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
                    accessible-role: list-item;
                    accessible-label: l.number;
                    accessible-action-default => {
                        root.pick("doc-link", i, 0);
                    }
                    touch := TouchArea {
                        clicked => {
                            root.pick("doc-link", i, 0);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 10px;
                        Cell { width: 140px; text: l.status == "original" ? @tr("Original sale") : l.status == "exchange" ? @tr("Exchange sale") : @tr("Return"); color: Theme.muted; }
                        Cell { horizontal-stretch: 1; text: l.number; font-weight: 600; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    KeyButton {
                        keys: "Esc";
                        text: @tr("Back");
                        clicked => {
                            root.action("detail-back");
                        }
                    }
                    if root.links.length > 0: KeyButton {
                        keys: "Enter";
                        text: @tr("Open");
                        clicked => {
                            root.action("sales-open");
                        }
                    }
                }
            }
        }
        Card {
            width: 400px;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                SectionTitle {
                    text: @tr("Receipt");
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        for line in root.receipt: Text {
                            text: line;
                            font-family: Theme.mono;
                            font-size: 12px;
                            color: Theme.text;
                        }
                    }
                }
            }
        }
    }
}

// The customer form's purchase history (Ctrl+H).
export component CustomerHistoryScreen inherits VerticalLayout {
    in property <string> name;
    in property <[BoDocRow]> rows;
    in property <BoDocList> list;
    callback action(string);
    callback pick(string, int, int);
    padding: 16px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 10px;
        SectionTitle {
            text: @tr("Purchase history of {}", root.name);
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        KeyButton {
            keys: "Esc";
            text: @tr("Back to the customer");
            clicked => {
                root.action("history-back");
            }
        }
    }
    Hint {
        text: @tr("Sales and returns at every branch, newest first, including customers merged into this one. Voided sales are marked VOID.");
    }
    Banner {
        note: root.list.notice;
    }
    DocTable {
        vertical-stretch: 1;
        rows: root.rows;
        list: root.list;
        pick-kind: "history-row";
        show-cashier: false;
        customer-head: @tr("Posted for (merged)");
        pick(k, r, s) => {
            root.pick(k, r, s);
        }
        action(id) => {
            root.action(id);
        }
    }
}

// Tender types (Ctrl+3, HQ).
export component TenderTypesScreen inherits VerticalLayout {
    in property <string> screen;
    in property <[BoTenderRow]> rows;
    in property <BoTenderEditor> editor;
    in property <Note> read-only;
    in property <int> serial;
    callback action(string);
    callback edit(string, int, int, string, string);
    callback toggle(string, int, string, bool);
    callback choose(string, int, string, int);
    callback pick(string, int, int);
    padding: 16px;
    spacing: 12px;

    SalesTabs {
        screen: root.screen;
        action(id) => {
            root.action(id);
        }
    }
    Banner {
        note: root.read-only;
    }
    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 1px;
                HorizontalLayout {
                    height: 34px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    Head { horizontal-stretch: 1; preferred-width: 0px; text: @tr("Name"); }
                    Head { width: 130px; text: @tr("Kind"); }
                    Head { width: 190px; text: ""; }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                ListView {
                    vertical-stretch: 1;
                    for row[i] in root.rows: Rectangle {
                        height: 38px;
                        background: i == root.editor.cursor && !root.editor.is-new ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
                        accessible-role: list-item;
                        accessible-label: row.name;
                        accessible-action-default => {
                            root.pick("tender-row", i, 0);
                        }
                        touch := TouchArea {
                            clicked => {
                                root.pick("tender-row", i, 0);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            Cell { horizontal-stretch: 1; preferred-width: 0px; text: row.name; font-weight: 600; color: row.active && !row.archived ? Theme.text : Theme.muted; }
                            Cell { width: 130px; text: BoStrings.label("tender_" + row.kind); color: Theme.muted; }
                            Cell {
                                width: 190px;
                                text: row.archived ? @tr("archived") : (!row.active ? @tr("off") + " · " : "") + (row.needs-reference ? @tr("reference") : "") + (row.needs-reference && row.opens-drawer ? " · " : "") + (row.opens-drawer ? @tr("drawer") : "");
                                color: row.archived || !row.active ? Theme.warn : Theme.muted;
                                font-size: 12px;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
            }
        }
        Card {
            width: 460px;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: start;
                SectionTitle {
                    text: root.editor.is-new ? @tr("New tender type") : @tr("Edit tender type");
                }
                for s in [root.serial]: VerticalLayout {
                    spacing: 10px;
                    Field {
                        label: @tr("Name (printed on receipts)");
                        text: root.editor.name;
                        enabled: root.editor.can-edit;
                        edited(t) => {
                            root.edit("tender", 0, 0, "name", t);
                        }
                    }
                    Picker {
                        label: root.editor.is-new ? @tr("Kind") : @tr("Kind (fixed once saved)");
                        model: [BoStrings.label("tender_cash"), BoStrings.label("tender_card"), BoStrings.label("tender_qris"), BoStrings.label("tender_transfer"), BoStrings.label("tender_ewallet"), BoStrings.label("tender_customer_balance"), BoStrings.label("tender_other")];
                        index: root.editor.kind-index;
                        enabled: root.editor.can-edit && root.editor.is-new;
                        selected(i) => {
                            root.choose("tender", 0, "kind", i);
                        }
                    }
                    CheckBox {
                        text: @tr("Needs a reference (EDC or app number)");
                        checked: root.editor.needs-reference;
                        enabled: root.editor.can-edit;
                        toggled => {
                            root.toggle("tender", 0, "needs_reference", self.checked);
                        }
                    }
                    CheckBox {
                        text: @tr("Opens the cash drawer");
                        checked: root.editor.opens-drawer;
                        enabled: root.editor.can-edit;
                        toggled => {
                            root.toggle("tender", 0, "opens_drawer", self.checked);
                        }
                    }
                    CheckBox {
                        text: @tr("Active (offered at the register)");
                        checked: root.editor.active;
                        enabled: root.editor.can-edit;
                        toggled => {
                            root.toggle("tender", 0, "active", self.checked);
                        }
                    }
                    Field {
                        label: @tr("Position");
                        text: root.editor.sort;
                        enabled: root.editor.can-edit;
                        edited(t) => {
                            root.edit("tender", 0, 0, "sort", t);
                        }
                    }
                }
                if root.editor.archived: Hint {
                    text: @tr("Archived: it can no longer be edited or used.");
                }
                Banner {
                    note: root.editor.notice;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    KeyButton {
                        keys: "Ctrl+S";
                        text: @tr("Save");
                        primary: true;
                        enabled: root.editor.can-edit;
                        clicked => {
                            root.action("tender-save");
                        }
                    }
                    KeyButton {
                        keys: "Ctrl+N";
                        text: @tr("New");
                        enabled: root.read-only.code == "";
                        clicked => {
                            root.action("tender-new");
                        }
                    }
                    KeyButton {
                        keys: "Ctrl+Shift+A";
                        text: @tr("Archive");
                        enabled: root.editor.can-edit && !root.editor.is-new;
                        clicked => {
                            root.action("tender-archive");
                        }
                    }
                }
            }
        }
    }
}

// Sales settings (Ctrl+4, HQ).
export component SalesSettingsScreen inherits VerticalLayout {
    in property <string> screen;
    in property <BoSalesSettings> settings;
    in property <[BoWidthRow]> widths;
    in property <Note> read-only;
    in property <int> serial;
    callback action(string);
    callback edit(string, int, int, string, string);
    callback choose(string, int, string, int);
    padding: 16px;
    spacing: 12px;

    SalesTabs {
        screen: root.screen;
        action(id) => {
            root.action(id);
        }
    }
    Banner {
        note: root.read-only;
    }
    HorizontalLayout {
        alignment: start;
        vertical-stretch: 1;
        Card {
            width: 600px;
            height: box.preferred-height;
            box := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                SectionTitle {
                    text: @tr("Sales settings");
                }
                for s in [root.serial]: Field {
                    label: @tr("Return window in days (0 = no limit)");
                    text: root.settings.return-days;
                    enabled: root.settings.can-edit;
                    edited(t) => {
                        root.edit("sales-settings", 0, 0, "return_days", t);
                    }
                }
                Hint {
                    text: @tr("A return by receipt older than this needs a manager's approval at the till.");
                }
                for s in [root.serial]: Field {
                    label: @tr("Missing nota from (Rp, 0 = off)");
                    text: root.settings.nota-flag-above;
                    placeholder: "100.000";
                    enabled: root.settings.can-edit;
                    edited(t) => {
                        root.edit("sales-settings", 0, 0, "nota_flag_above", t);
                    }
                }
                Hint {
                    text: @tr("A cash out of at least this amount without a nota photo is flagged “missing nota”. Left empty, the current amount stays.");
                }
                SectionTitle {
                    text: @tr("Receipt width per branch");
                }
                for w[i] in root.widths: HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: w.branch;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ComboBox {
                        width: 160px;
                        model: [@tr("32 columns"), @tr("42 columns"), @tr("48 columns")];
                        current-index: w.index;
                        enabled: root.settings.can-edit;
                        accessible-label: @tr("Receipt width") + " " + w.branch;
                        selected(v) => {
                            root.choose("sales-settings", i, "width", self.current-index);
                        }
                    }
                }
                Hint {
                    text: @tr("58 mm printers print 32 columns, 80 mm printers 42 or 48.");
                }
                Banner {
                    note: root.settings.notice;
                }
                HorizontalLayout {
                    alignment: start;
                    KeyButton {
                        keys: "Ctrl+S";
                        text: @tr("Save");
                        primary: true;
                        enabled: root.settings.can-edit && root.settings.loaded;
                        clicked => {
                            root.action("sales-settings-save");
                        }
                    }
                }
            }
        }
    }
}
